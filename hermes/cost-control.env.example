# Hermes cost controls. Store real values in Hermes Keys, never commit them.
# These knobs bound spend and stop one Telegram turn from fanning out into
# hundreds of provider calls. Keep them aligned with the OpenRouter account
# limit on the dedicated "Hermes" key (the last section below).

# Hard spend ceilings. When a ceiling is reached, follow
# HERMES_BUDGET_EXCEEDED_ACTION; never silently keep spending.
HERMES_MONTHLY_BUDGET_USD=10
HERMES_DAILY_BUDGET_USD=3

# Per-turn provider-call guard. A single Telegram message must not expand into
# a long tool-call loop. Up to the first cap a turn may keep working; at that
# count it must compact context and finish.
HERMES_MAX_PROVIDER_CALLS_PER_TURN=12
# Absolute stop: never exceed this many provider calls in one turn.
HERMES_HARD_MAX_PROVIDER_CALLS_PER_TURN=20

# Token hygiene. Long-context turns are the dominant cost driver: re-sending
# full history on every tool call multiplies spend. Bound per-call input and
# output, and compact before the turn exceeds the token budget.
HERMES_MAX_INPUT_TOKENS_PER_CALL=32000
HERMES_MAX_OUTPUT_TOKENS_PER_CALL=2048
HERMES_MAX_TOKENS_PER_TURN=60000

# What to do when a budget ceiling is hit: `stop` halts the turn and reports
# the limit; `degrade_to_cheap` may continue only on the low-risk model tier.
HERMES_BUDGET_EXCEEDED_ACTION=stop

# OpenRouter account-level cap (set in the dashboard, not this file). Create a
# dedicated key named "Hermes" and set a monthly spend limit under OpenRouter
# Keys -> Limits. Record that dashboard value below so the cap lives next to
# the gateway guardrails.
# OPENROUTER_KEY_SPEND_LIMIT_USD=10
