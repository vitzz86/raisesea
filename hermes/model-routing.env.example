# Store actual API keys in Hermes Keys. Never commit values.
OPENROUTER_API_KEY=

# Policy labels used by the profile runbooks. Confirm currently available model
# IDs and prices in OpenRouter before setting production values.
RAISESEA_CODING_PRIMARY=openai-codex
RAISESEA_CODING_FALLBACK_1=deepseek
RAISESEA_CODING_FALLBACK_2=openrouter-reliable-coding
RAISESEA_REASONING_PRIMARY=deepseek
RAISESEA_LOW_RISK_PROVIDER=openrouter
RAISESEA_LOW_RISK_MODEL=select-current-low-cost-model

# Nemotron or another inexpensive model is permitted only for low-risk work.
RAISESEA_LOW_RISK_ALLOWED_TASKS=idea_capture,classification,reminders,formatting

# Budget and request-expansion guardrails live in hermes/cost-control.env.example.
# Keep this key's OpenRouter spend limit aligned with those ceilings.
